import "blueprint.node_style" for COL_PANEL_BG
import "network.vertex_shape" for VertexShape, SHAPE_CIRCLE
import "network.render" for Render
import "network.network" for Network
import "maths.vector" for Vector2
import "maths" for Float2

class Vertex
{
	init()
	{
		this.shape = SHAPE_CIRCLE

		this.pin_types_f = []
		this.pin_types_t = []

		this.pins = []
		this.pin_dynamic = true

		this.pos = Vector2()

		this.color = COL_PANEL_BG

		this.selected = false

		// Shared with blueprint/tree nodes via components["bp"]: the editor's
		// draw / aabb loops read these on every scene node regardless of family,
		// so keep the field set uniform (Vessel raises on reading an unset field).
		this.visible = true
		this.aabb_dirty = false

		// Scene-position stamp for editor.query_node_idx (see blueprint Node).
		this.sort_idx = -1

		// Reused across update() calls so the per-frame move check doesn't
		// allocate a foreign Float2 per node per frame (GC churn).
		this.pos_probe = Float2.init()

		this.flag = nil

		// fixme: update aabb
		this.shape_rod_hori = true

		this.params = []
	}

	get_size() 
	{
		return VertexShape.calc_aabb(this)
	}

	update(mt)
	{
		if (this.shape_rod_hori != VertexShape.is_shape_rod_hori(this)) {
			this.aabb_dirty = true
			this.shape_rod_hori = !this.shape_rod_hori
		}

		// transform() applies mt to the CURRENT value, so reset to origin first;
		// mt * (0,0) = mt's translation, same as a fresh Float2.
		var pos = this.pos_probe
		pos.set_x(0)
		pos.set_y(0)
		pos.transform(mt)
		if (this.pos.x == pos.x() and this.pos.y == pos.y()) {
			return
		}
		this.pos.x = pos.x()
		this.pos.y = pos.y()

		this.update_pin_conns()
	}

	update_pin_conns()
	{
		for (var p in this.pins) {
			for (var edge in p.edges) {
				edge.update()			
			}
		}
	}

	draw(mt, cam_mt)
	{
		Render.draw_vertex(this)
	}

	draw_gui(ctx) 
	{
	}

	to_string(name) 
	{
		var ret = ""
		for (var p in this.params) {
			ret = ret + p.to_string(name)
		}
		return ret
	}

	on_selected() { this.selected = true }
	on_deselected() { this.selected = false }

	on_key_pressed(key) {}
	on_key_released(key) {}
	on_mouse_pressed(x, y, btn) {}
	on_mouse_released(x, y, btn) {}
	on_mouse_moved(x, y, btn) {}
	on_mouse_dragged(x, y, btn) {}
	on_mouse_clicked(x, y, btn) {}
	on_mouse_scrolled(x, y, dx, dy) {}

	on_connection_changed() {}
	
	disconnect()
	{
		for (var p in this.pins) {
			for (var edge in p.edges) {
				Network.disconnect(edge)
			}
		}
	}

	on_scene_add(editor) {}
	
	get_title()
	{
		return this.get_class().name
	}

	bind_editor() { return false }
	draw_editor() {}

	add_pin(pin)
	{
		if (this.pin_dynamic) {
			this.pins.add(pin)
		}
	}

	remove_pin(pin)
	{
		if (this.pin_dynamic) {
			this.pins.remove(pin)
		}
	}

	query_param(name)
	{
		for (var p in this.params) {
			if (p.name == name) {
				return p
			}
		}
		return nil
	}
}
