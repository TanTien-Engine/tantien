import "math" for Math
import "geometry" for Bezier
import "maths.vector" for Vector2
import "blueprint.node_layout" for NodeLayout, CONNECTING_BEZIER_DIST

class Connecting
{
	init(from, to)
	{
		this.from = from
		this.to   = to
		
		this.curve = Bezier.init()
	}

	update()
	{
		this.update_curve()

		// This wire is DRAWN by its source node (NodeRender iterates node.exports),
		// so any curve recompute -- a moved endpoint, connect/disconnect, or a
		// hidden pass-through following its producer -- invalidates that node's
		// cached wire Painter. This is the single catch-all for wire-geometry
		// staleness; the per-event hooks in Node cover panel/pins.
		this.from.node.render_dirty = true
	}

	update_curve()
	{
		var f_pos = NodeLayout.calc_pin_pos(this.resolve_from(this.from))
		var t_pos = NodeLayout.calc_pin_pos(this.to)
		Connecting.build_curve(f_pos, t_pos, this.curve)
	}

	// Resolve a wire's START pin through any HIDDEN pass-through nodes (e.g. the
	// history-rebuild's parked Cache wrappers) up to the first VISIBLE producer's
	// export pin. A hidden node owns the DRAWN outgoing wire but is parked once on
	// its producer and never moves with it; anchoring the wire's start to the live
	// producer pin keeps the link glued to the producer when it is later dragged.
	// A visible from-pin returns unchanged (the loop never runs), so this is a
	// no-op for ordinary graphs.
	resolve_from(pin)
	{
		var guard = 0
		while (pin and !pin.node.visible) {
			var up = nil
			for (var p in pin.node.imports) {
				if (!p.conns.isEmpty) {
					up = p.conns.front().from
					break
				}
			}
			if (!up) {
				break
			}
			pin = up
			guard = guard + 1
			if (guard > 128) {
				break
			}
		}
		return pin
	}

	static build_curve(p0, p1, curve)
	{
		var d = Math.abs(p1.x - p0.x) * CONNECTING_BEZIER_DIST
		var v1 = Vector2(p0.x + d, p0.y)
		var v2 = Vector2(p1.x - d, p1.y)
		curve.set_ctrl_pos([p0.x, p0.y, v1.x, v1.y, v2.x, v2.y, p1.x, p1.y])
	}
}