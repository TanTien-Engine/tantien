import "blueprint.node" for Node
import "blueprint.pin" for Pin
import "blueprint.variant" for Variant, VAR_TYPE_NUMBER, VAR_TYPE_NUMBER3, VAR_TYPE_MATRIX4
import "blueprint.node_layout" for DEFAULT_HEIGHT
import "gui" for GUI
import "maths" for Matrix44
import "blueprint.blueprint" for Blueprint
import "math" for Math

class Perspective is Node
{
	init() 
	{
		super.init()

		this.imports = [
			Pin(this, "fovy",    VAR_TYPE_NUMBER),
			// Optional: when cam_pos + bb_min + bb_max are all wired, znear/
			// zfar are computed to hug the model's bounding sphere instead of
			// using the fixed znear/zfar fields. Lets the view stay z-fight
			// free at any model scale (e.g. ZW3D mm imports with unit_scale=1).
			Pin(this, "cam_pos", VAR_TYPE_NUMBER3),
			Pin(this, "bb_min",  VAR_TYPE_NUMBER3),
			Pin(this, "bb_max",  VAR_TYPE_NUMBER3),
		]
		this.exports = [
			Pin(this, "mat",   VAR_TYPE_MATRIX4),
			Pin(this, "znear", VAR_TYPE_NUMBER),
			Pin(this, "zfar",  VAR_TYPE_NUMBER),
		]

		this.layout()

		this.fovy   = 45
		this.aspect = 0
		this.znear  = 0.1
		this.zfar   = 100
	}

	calc_value(idx)
	{
		if (idx == 0)
		{
			var fovy = Blueprint.calc_input_value(this, 0)
			if (fovy) {
				this.fovy = fovy.value
			}

			var clip = this.calc_clip()

			var mat = Matrix44.init()
			mat.perspective(this.fovy, this.aspect, clip[0], clip[1])
			return Variant(VAR_TYPE_MATRIX4, mat)
		}
		else if (idx == 1)
		{
			var clip = this.calc_clip()
			return Variant(clip[0])
		}
		else if (idx == 2)
		{
			var clip = this.calc_clip()
			return Variant(clip[1])
		}
	}

	// Returns [znear, zfar], fitted to the model's bounding box so the view
	// is z-fight free at any model scale. zfar = distance to the farthest
	// bbox corner. znear = distance to the NEAREST POINT ON the bbox (the
	// camera clamped into the box) -- NOT the nearest corner: when the
	// camera moves close to a face, or inside the box, the nearest corner is
	// still far away, so a corner-based near plane would clip the model. The
	// clamp gives the true near distance (0 when inside). 0.9 / 1.1 are
	// safety margins; the floor just keeps znear positive. Falls back to the
	// manual znear / zfar fields when the inputs are not connected.
	calc_clip()
	{
		var v_cam = Blueprint.calc_input_value(this, 1)
		var v_min = Blueprint.calc_input_value(this, 2)
		var v_max = Blueprint.calc_input_value(this, 3)

		if (v_cam and v_min and v_max)
		{
			var cam = v_cam.value
			var mn = v_min.value
			var mx = v_max.value

			// zfar: the farthest point of an AABB is always a corner.
			var xs = [mn.x, mx.x]
			var ys = [mn.y, mx.y]
			var zs = [mn.z, mx.z]
			var far = 0
			for (var cx in xs) {
				for (var cy in ys) {
					for (var cz in zs) {
						var dx = cx - cam.x
						var dy = cy - cam.y
						var dz = cz - cam.z
						var d = Math.sqrt(dx * dx + dy * dy + dz * dz)
						if (d > far) {
							far = d
						}
					}
				}
			}

			// znear: nearest point on the box = the camera clamped into it.
			var qx = cam.x
			if (qx < mn.x) {
				qx = mn.x
			} else if (qx > mx.x) {
				qx = mx.x
			}
			var qy = cam.y
			if (qy < mn.y) {
				qy = mn.y
			} else if (qy > mx.y) {
				qy = mx.y
			}
			var qz = cam.z
			if (qz < mn.z) {
				qz = mn.z
			} else if (qz > mx.z) {
				qz = mx.z
			}
			var nx = cam.x - qx
			var ny = cam.y - qy
			var nz = cam.z - qz
			var near = Math.sqrt(nx * nx + ny * ny + nz * nz)

			far = far * 1.1
			near = near * 0.9
			var floor = far * 0.0001
			if (near < floor) {
				near = floor
			}

			return [near, far]
		}

		return [this.znear, this.zfar]
	}

	layout() 
	{
		super.layout()

		this.style.height = this.style.height + DEFAULT_HEIGHT * 4
	}

	to_string(name) {
		return "
%(name).fovy = %(this.fovy)
%(name).aspect = %(this.aspect)
%(name).znear = %(this.znear)
%(name).zfar = %(this.zfar)
"
	}

	draw_gui(ctx) 
	{
		var dirty = false

		var x = this.pos.x - this.style.width * 0.5
		var y = this.pos.y + this.style.height * 0.5 - this.calc_panel_height() - DEFAULT_HEIGHT

		var fovy = GUI.slider(ctx, "fovy", this.fovy, x, y, this.style.width - 20, 180, false)
		if (fovy != this.fovy) {
			this.fovy = fovy
			dirty = true
		}
		y = y - DEFAULT_HEIGHT

		var aspect = GUI.slider(ctx, "aspect", this.aspect, x, y, this.style.width - 20, 1, false)
		if (aspect != this.aspect) {
			this.aspect = aspect
			dirty = true
		}
		y = y - DEFAULT_HEIGHT

		var znear = GUI.slider(ctx, "znear", this.znear, x, y, this.style.width - 20, 0.1, false)
		if (znear != this.znear) {
			this.znear = znear
			dirty = true
		}
		y = y - DEFAULT_HEIGHT

		var zfar = GUI.slider(ctx, "zfar", this.zfar, x, y, this.style.width - 20, 1000, false)
		if (zfar != this.zfar) {
			this.zfar = zfar
			dirty = true
		}
		y = y - DEFAULT_HEIGHT

		return dirty
	}
}