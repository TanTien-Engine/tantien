// Integration acceptance assets probe:
//   A03: .brep-only input -> REAL domain STEP re-export -> RecoverStep DELIVERED
//   A02b: non-plate supported structure (L bracket) through the same chain
//   rejection path: empty/invalid STEP import refused, nothing fabricated
//
// Run from the TANTIEN PARENT root:
//   CAX_DEPARAM_PYTHON=<venv python> ./out_mac/Debug/ves_test test_integration_assets

import "review" for ReviewWorkbench
import "review.routes" for RouteRunner
import "intent" for IntentWorkbench
import "tasks" for Json, Tasks
import "filesystem" for Filesystem
import "cadapp" for CadSession

class Probe
{
	// Acceptance output root: default keeps the historical directory, an
	// explicit CAX_INTEGRATION_ROOT redirects a fresh acceptance run.
	static integration_root()
	{
		var root = CadSession.env("CAX_INTEGRATION_ROOT")
		if (root == nil) { root = "thirdparty/cax/outputs/integration_20261117" }
		return root
	}

	// Child processes run with cwd = cax root: strip the repo prefix when
	// the root uses the host-relative form (absolute overrides pass through).
	static child_root(root)
	{
		return root.replace("thirdparty/cax/", "")
	}

	init()
	{
		this.fail = 0
		this.checks = 0
	}

	check(cond, label)
	{
		this.checks = this.checks + 1
		if (cond) {
			System.print("[OK] %(label)")
		} else {
			System.print("[FAIL] %(label)")
			this.fail = this.fail + 1
		}
	}

	wait_run(runner, id, timeout_ms)
	{
		var deadline = Tasks.now_ms() + timeout_ms
		while (Tasks.now_ms() < deadline) {
			runner.poll()
			var run = runner.runs[id]
			if (run != nil and run["done"]) { return run }
			Tasks.wait_ms(20)
		}
		return nil
	}

	run_file_action(runner, path, code)
	{
		var child_path = ReviewWorkbench.to_child_cwd_path(path)
		var pid = Tasks.spawn([runner.caps["exe"], "-B", "-c", code, child_path], nil, runner.cax_root)
		if (pid == 0) { return false }
		var deadline = Tasks.now_ms() + 30000
		while (Tasks.now_ms() < deadline) {
			var state = Tasks.poll(pid)
			if (!state[0]) { return state[1] == 0 }
			Tasks.wait_ms(20)
		}
		Tasks.kill_tree(pid, 1)
		return false
	}

	run()
	{
		var root = Probe.integration_root()
		var asset_dir = root + "/assets"

		// ---- rejection path FIRST: empty/invalid input is refused ----
		var wb_bad = ReviewWorkbench.create()
		var bad = Json.parse(wb_bad.import_input(asset_dir + "/empty.step"))
		this.check(bad["ok"] == false, "empty .step import refused (no fabricated facts)")

		// ---- A03: brep-only input -> domain STEP re-export -> recovery ----
		var wb = ReviewWorkbench.create()
		var events_path = root + "/events_assets.jsonl"
		Filesystem.remove_file(events_path)
		wb.set_event_log(events_path)
		var imported = wb.import_input(asset_dir + "/plate_only.brep")
		this.check(imported, "brep-only input imported natively")
		var conv_path = root + "/converted_brep.step"
		var conv = Json.parse(wb.export_input_step(conv_path))
		this.check(conv["ok"], "domain re-export produced a REAL STEP from the brep")
		this.check(conv["result"]["source_sha256"] != conv["result"]["exported_sha256"],
			"original and conversion artifact identities recorded separately")

		var runner = RouteRunner()
		runner.out_root = root + "/routes"
		runner.out_root_child = Probe.child_root(root) + "/routes"
		runner.probe("")
		var waited = 0
		while (runner.caps == nil and waited < 30000) {
			Tasks.wait_ms(20)
			waited = waited + 20
			runner.poll()
		}
		// O05 r2: the SAME production start path (start_bound -- the one
		// workbench.start_recover_step uses) binds the ORIGINAL brep as
		// the review identity and the converted STEP as the worker input.
		var brep_path = asset_dir + "/plate_only.brep"
		var run = runner.start_bound(wb, "geometry", brep_path, conv_path,
			90, nil)
		this.check(run != nil, "RecoverStep started on the CONVERTED step")
		this.check(run != nil and runner.runs[run]["context_input_path"] == brep_path and
			runner.runs[run]["worker_input_path"] == conv_path and
			runner.runs[run]["context_input_sha256"] != nil,
			"start_bound binds original + worker input identities")
		var done = this.wait_run(runner, run, 180000)
		this.check(done != nil and done["status"] == "DELIVERED",
			"converted-input recovery DELIVERED (got %(done == nil ? "TIMEOUT" : done["status"]))")


		// The full chain on the converted input: import/validate/adopt.
		var imp = runner.import_candidate(wb, run)
		this.check(imp != nil and imp["ok"], "converted-input candidate imported")
		var cand_id = imp["result"]["candidate"]
		var validated = Json.parse(wb.validate_candidate("assets-validate", cand_id))
		this.check(validated["ok"], "converted-input candidate validated")
		var adopted = Json.parse(wb.adopt_candidate("assets-adopt", cand_id))
		this.check(adopted["ok"], "converted-input candidate adopted")
		var intent = wb.create_intent()
		var m = Json.parse(intent.measure())
		this.check(m["ok"] and m["result"]["volume"] > 46000 and
			m["result"]["volume"] < 47000,
			"brep-origin document measures the plate volume (got %(m["result"]["volume"]))")

		// O05 r2 negative: mutating the ORIGINAL brep content under the
		// same path must make the public gate refuse the queued result.
		var orig_bytes_ok = true
		var mutated_reply = nil
		if (done != nil and done["status"] == "DELIVERED") {
			var current = Json.parse(wb.state_json())
			runner.runs[run]["context_revision"] = current["document_revision"]
			runner.runs[run]["context_review_revision"] = current["review_revision"]
			var original_sha = Tasks.sha256(brep_path)
			var mutate_code = "import pathlib,sys; p=pathlib.Path(sys.argv[1]); b=p.with_name(p.name+'.probe-backup'); assert not b.exists(); b.write_bytes(p.read_bytes()); p.write_bytes(p.read_bytes()+b'\\nprobe mutation\\n')"
			var restore_code = "import os,pathlib,sys; p=pathlib.Path(sys.argv[1]); b=p.with_name(p.name+'.probe-backup'); os.replace(b,p)"
			var mutated = this.run_file_action(runner, brep_path, mutate_code)
			if (mutated) { mutated_reply = runner.import_candidate(wb, run) }
			var restored = this.run_file_action(runner, brep_path, restore_code)
			orig_bytes_ok = (mutated and restored and original_sha == Tasks.sha256(brep_path) and
				mutated_reply != nil and mutated_reply["ok"] == false and
				mutated_reply["error"].contains("input content"))
		}
		this.check(done != nil and done["status"] != "DELIVERED" or orig_bytes_ok,
			"gate refuses the queued result after original-content mutation")


		// ---- A02b: a DIFFERENT supported structure (L bracket) ----
		var wb2 = ReviewWorkbench.create()
		var imported2 = wb2.import_input(asset_dir + "/l_bracket.step")
		this.check(imported2, "l bracket imported")
		// O05 r2: the same production start path binds the context
		var run2 = runner.start_bound(wb2, "geometry",
			asset_dir + "/l_bracket.step", asset_dir + "/l_bracket.step",
			90, nil)
		var done2 = this.wait_run(runner, run2, 180000)
		this.check(done2 != nil, "l bracket recovery reached a terminal state")
		if (done2 != nil) {
			// The receipt status is REPORTED VERBATIM: DELIVERED when the
			// backend supports the structure, the real refusal otherwise.
			System.print("l bracket receipt status: %(done2["status"])")
			if (done2["status"] == "DELIVERED") {
				var imp2 = runner.import_candidate(wb2, run2)
				if (imp2 == nil or !imp2["ok"]) {
					System.print("l bracket import reply: %(imp2)")
				}
				this.check(imp2 != nil and imp2["ok"], "l bracket candidate imported")
				var v2 = Json.parse(wb2.validate_candidate("assets-validate-l", imp2["result"]["candidate"]))
				this.check(v2["ok"], "l bracket candidate validated against its input")
				var a2 = Json.parse(wb2.adopt_candidate("assets-adopt-l", imp2["result"]["candidate"]))
				this.check(a2["ok"], "l bracket candidate adopted")
				var intent2 = wb2.create_intent()
				var m2 = Json.parse(intent2.measure())
				this.check(m2["ok"] and m2["result"]["volume"] > 57000 and
					m2["result"]["volume"] < 58000,
					"l bracket volume measured (union minus overlap, got %(m2["result"]["volume"]))")
				// the recovered l bracket projects as EDITABLE nodes
				var p2 = Json.parse(intent2.project_graph())
				var editable = false
				for (var n in p2["result"]["graph"]["nodes"]) {
					if (n["op"] == "Extrude") { editable = true }
				}
				this.check(editable, "l bracket recovered chain projects EDITABLE")
			} else {
				System.print("l bracket NOT supported by this backend build; recorded honestly")
			}
		}

		System.print("assets probe done: %(this.fail) failure(s) / %(this.checks) checks")
		return this.fail
	}
}

class Main
{
	static run()
	{
		return Probe().run()
	}
}
